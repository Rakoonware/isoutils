{
  "extends": "./tsconfig.lib.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "module": "CommonJS",
    "moduleResolution": "node10",
    "outDir": "./dist/cjs",
    "tsBuildInfoFile": "node_modules/.tmp/tsconfig.lib.cjs.tsbuildinfo"
  }
}
